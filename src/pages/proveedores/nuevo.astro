---
import MainLayout from '../../layouts/MainLayout.astro';

const isEditing = Boolean(Astro.url.searchParams.get('id'));
const pageTitle = isEditing ? 'Editar proveedor' : 'Nuevo proveedor';
---

<MainLayout title={pageTitle}>
  <section class="mx-auto w-full max-w-5xl px-4 pb-8 pt-5 sm:px-6 md:px-8 md:pt-8">
    <div class="sticky top-14 z-40 -mx-4 mb-8 flex flex-col justify-between gap-5 border-b border-outline-variant bg-surface px-4 py-4 sm:-mx-6 sm:flex-row sm:items-end sm:px-6 md:-mx-8 md:px-8">
      <div>
        <a href="/proveedores" class="inline-flex items-center gap-1 text-xs font-bold text-forest hover:text-[#164737]"><span class="material-symbols-outlined text-base">arrow_back</span>Proveedores</a>
        <p class="mb-2 mt-4 text-xs font-bold uppercase tracking-[0.2em] text-forest">Directorio de abastecimiento</p>
        <h2 id="supplier-page-title" class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">{pageTitle}</h2>
        <p class="mt-2 text-sm leading-6 text-muted">Registra la información necesaria para gestionar tus compras y cuentas por pagar.</p>
      </div>
      <div class="flex gap-3">
        <a href="/proveedores" class="rounded-xl border border-line px-4 py-2.5 text-sm font-bold text-ink transition hover:border-forest hover:text-forest">Cancelar</a>
        <button id="supplier-save-top" form="supplier-form" type="submit" class="rounded-xl bg-forest px-4 py-2.5 text-sm font-bold text-white transition hover:bg-[#164737]">{isEditing ? 'Actualizar proveedor' : 'Guardar proveedor'}</button>
      </div>
    </div>

    <form id="supplier-form" class="space-y-6" novalidate>
      <p class="text-xs text-muted">Los campos marcados con <span class="font-bold text-coral" aria-hidden="true">*</span><span class="sr-only"> asterisco</span> son obligatorios.</p>
      <fieldset class="rounded-2xl border border-line bg-white p-5 sm:p-6">
        <legend class="px-1 font-display text-lg font-bold text-ink">Datos del proveedor</legend>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <label class="text-sm font-bold text-ink sm:col-span-2">Nombre <span class="text-coral" aria-hidden="true">*</span><span class="sr-only">obligatorio</span><input name="nombre" required maxlength="150" class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest" /></label>
          <label class="text-sm font-bold text-ink">Identificación fiscal <span class="text-coral" aria-hidden="true">*</span><span class="sr-only">obligatorio</span><input name="identificacionFiscal" required maxlength="30" placeholder="J-00000000-0" class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest" /></label>
          <label class="text-sm font-bold text-ink">Estado <span class="text-coral" aria-hidden="true">*</span><span class="sr-only">obligatorio</span><select name="estado" required class="mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"><option value="activo">Activo</option><option value="inactivo">Inactivo</option></select></label>
          <label class="text-sm font-bold text-ink">Teléfono<input name="telefono" type="tel" maxlength="30" class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest" /></label>
          <label class="text-sm font-bold text-ink">Correo electrónico<input name="email" type="email" maxlength="150" class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest" /></label>
          <label class="text-sm font-bold text-ink">Días de plazo <span class="text-coral" aria-hidden="true">*</span><span class="sr-only">obligatorio</span><input name="diasPlazo" required type="number" min="0" max="365" step="1" value="0" class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest" /></label>
          <label class="text-sm font-bold text-ink sm:col-span-2 lg:col-span-3">Dirección<input name="direccion" maxlength="255" class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest" /></label>
        </div>
      </fieldset>
      <div id="form-feedback" class="hidden rounded-xl border px-4 py-3 text-sm font-bold" role="status" aria-live="polite"></div>
    </form>
  </section>
</MainLayout>

<script>
  const apiBaseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
  const form = document.querySelector<HTMLFormElement>('#supplier-form');
  const feedback = document.querySelector<HTMLElement>('#form-feedback');
  const editId = new URLSearchParams(window.location.search).get('id');
  const setField = (name: string, value: unknown) => { const field = form?.elements.namedItem(name) as HTMLInputElement | null; if (field) field.value = String(value ?? ''); };

  if (editId) {
    fetch(`${apiBaseUrl}api/proveedores.php?id=${encodeURIComponent(editId)}`).then((response) => response.ok ? response.json() : Promise.reject()).then(({ supplier }) => {
      setField('nombre', supplier.nombre); setField('identificacionFiscal', supplier.identificacion_fiscal); setField('estado', supplier.estado); setField('telefono', supplier.telefono); setField('email', supplier.email); setField('diasPlazo', supplier.dias_plazo); setField('direccion', supplier.direccion);
    }).catch(() => { if (feedback) { feedback.textContent = 'No fue posible cargar el proveedor.'; feedback.className = 'rounded-xl border border-[#ffdad6] bg-[#fff0eb] px-4 py-3 text-sm font-bold text-coral'; } });
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const data = Object.fromEntries(new FormData(form));
    fetch(`${apiBaseUrl}api/proveedores.php${editId ? `?id=${encodeURIComponent(editId)}` : ''}`, { method: editId ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
      .then(async (response) => ({ ok: response.ok, data: await response.json().catch(() => ({})) }))
      .then(({ ok, data }) => {
        if (!ok) throw new Error(data.message ?? 'No fue posible guardar el proveedor.');
        window.location.assign(`${apiBaseUrl}proveedores/`);
      })
      .catch((error: Error) => {
        if (!feedback) return;
        feedback.textContent = error.message;
        feedback.className = 'rounded-xl border border-[#ffdad6] bg-[#fff0eb] px-4 py-3 text-sm font-bold text-coral';
      });
  });
</script>
