---
import MainLayout from '../../layouts/MainLayout.astro';
import { formatCurrency, recentSales } from '../../data/mock';

const payments = recentSales.filter((sale) => sale.status === 'Pagada');
const totalCollected = payments.reduce((sum, payment) => sum + payment.total, 0);
---

<MainLayout title="Histórico de pagos de ventas">
	<section class="mx-auto w-full max-w-3xl space-y-6 px-4 pb-4 pt-5 sm:px-6 md:max-w-none md:px-8 md:pt-8">
		<div class="flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><a href="/ventas" class="mb-4 inline-flex items-center gap-1 text-xs font-bold text-secondary hover:underline"><span class="material-symbols-outlined text-[17px]">arrow_back</span>Volver a ventas</a><p class="mb-2 text-label-caps text-secondary">Cuentas por cobrar</p><h2 class="font-display text-3xl font-bold tracking-tight text-primary sm:text-4xl">Histórico de pagos</h2><p class="mt-2 max-w-xl text-sm leading-6 text-on-surface-variant">Consulta los cobros y abonos recibidos de tus clientes.</p></div><button id="export-button" class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-3 text-sm font-bold text-white transition-opacity hover:opacity-80"><span class="material-symbols-outlined text-[19px]">download</span>Exportar CSV</button></div>
		<div class="grid gap-4 sm:grid-cols-3"><div class="rounded-xl border border-surface-variant bg-surface-container-lowest p-4"><p class="text-sm text-on-surface-variant">Cobros registrados</p><p class="mt-3 text-display-md font-bold text-primary">{payments.length}</p></div><div class="rounded-xl border border-surface-variant bg-surface-container-lowest p-4"><p class="text-sm text-on-surface-variant">Total cobrado</p><p class="mt-3 text-display-md font-bold text-secondary">{formatCurrency(totalCollected)}</p></div><div class="rounded-xl border border-surface-variant bg-surface-container-lowest p-4"><p class="text-sm text-on-surface-variant">Último cobro</p><p class="mt-3 text-display-md font-bold text-primary">Hoy, 09:18</p></div></div>
		<section class="overflow-hidden rounded-xl border border-surface-variant bg-surface-container-lowest"><div class="border-b border-surface-variant px-4 py-4 sm:px-5"><h3 class="text-headline-sm font-bold text-primary">Cobros de clientes</h3><p class="mt-1 text-xs text-on-surface-variant">Historial de pagos aplicados a ventas</p></div><div class="overflow-x-auto"><table class="w-full min-w-175 text-left"><thead class="bg-surface-container-low text-label-caps text-on-surface-variant"><tr><th class="px-4 py-3 font-semibold sm:px-5">Documento / cliente</th><th class="px-4 py-3 font-semibold">Fecha</th><th class="px-4 py-3 font-semibold">Método</th><th class="px-4 py-3 text-right font-semibold">Monto cobrado</th></tr></thead><tbody>{payments.map((payment) => <tr class="border-t border-surface-variant text-sm"><td class="px-4 py-4 sm:px-5"><p class="font-bold text-primary">{payment.customer}</p><p class="mt-1 text-xs text-on-surface-variant">{payment.id}</p></td><td class="px-4 py-4 text-on-surface-variant">{payment.date}</td><td class="px-4 py-4 text-on-surface-variant">{payment.method}</td><td class="px-4 py-4 text-right font-bold text-secondary">{formatCurrency(payment.total)}</td></tr>)}</tbody></table></div></section>
	</section>
</MainLayout>

<script>
	document.querySelector('#export-button')?.addEventListener('click', () => { const link = document.createElement('a'); link.href = 'data:text/csv;charset=utf-8,Cliente,Documento,Fecha,Metodo,Monto%0AInversiones Roca,FAC-00481,Hoy,Pago movil,890.50'; link.download = 'historico-pagos-ventas.csv'; link.click(); });
</script>
