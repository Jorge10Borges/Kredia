---
import MainLayout from '../../layouts/MainLayout.astro';
import { customers, formatCurrency } from '../../data/mock';

const overdueCustomers = customers.filter((customer) => customer.status === 'En mora');
const totalOverdue = overdueCustomers.reduce((sum, customer) => sum + customer.balance, 0);
---

<MainLayout title="Alertas de ventas">
	<section class="mx-auto w-full max-w-3xl space-y-6 px-4 pb-4 pt-5 sm:px-6 md:max-w-none md:px-8 md:pt-8">
		<div class="flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><a href="/ventas" class="mb-4 inline-flex items-center gap-1 text-xs font-bold text-secondary hover:underline"><span class="material-symbols-outlined text-[17px]">arrow_back</span>Volver a ventas</a><p class="mb-2 text-label-caps text-error">Seguimiento urgente</p><h2 class="font-display text-3xl font-bold tracking-tight text-primary sm:text-4xl">Alertas de ventas</h2><p class="mt-2 max-w-xl text-sm leading-6 text-on-surface-variant">Clientes con cuentas por cobrar cuyo periodo de crédito ya venció.</p></div><a href="/credito" class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-3 text-sm font-bold text-white transition-opacity hover:opacity-80"><span class="material-symbols-outlined text-[19px]">payments</span>Ver cobranzas</a></div>
		<div class="flex items-start gap-3 rounded-xl border border-error bg-error-container px-4 py-4 text-on-error-container"><span class="material-symbols-outlined">warning</span><div><p class="font-bold">{overdueCustomers.length} clientes con crédito vencido</p><p class="mt-1 text-sm">Estas cuentas superaron el periodo de pago acordado.</p></div></div>
		<div class="grid gap-4 sm:grid-cols-3"><div class="rounded-xl border border-surface-variant bg-surface-container-lowest p-4"><p class="text-sm text-on-surface-variant">Cuentas vencidas</p><p class="mt-3 text-display-md font-bold text-error">{overdueCustomers.length}</p></div><div class="rounded-xl border border-surface-variant bg-surface-container-lowest p-4"><p class="text-sm text-on-surface-variant">Saldo vencido</p><p class="mt-3 text-display-md font-bold text-error">{formatCurrency(totalOverdue)}</p></div><div class="rounded-xl border border-surface-variant bg-surface-container-lowest p-4"><p class="text-sm text-on-surface-variant">Fecha de revisión</p><p class="mt-3 text-display-md font-bold text-primary">25 ago 2026</p></div></div>
		<section class="overflow-hidden rounded-xl border border-surface-variant bg-surface-container-lowest"><div class="border-b border-surface-variant px-4 py-4 sm:px-5"><h3 class="text-headline-sm font-bold text-primary">Clientes en mora</h3><p class="mt-1 text-xs text-on-surface-variant">Prioridad de cobranza según días de vencimiento</p></div><div class="divide-y divide-surface-variant">{overdueCustomers.map((customer) => <div class="flex flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-5"><div class="flex items-center gap-3"><span class="grid h-9 w-9 place-items-center rounded-full bg-error-container text-xs font-bold text-on-error-container">{customer.initials}</span><div><p class="font-bold text-primary">{customer.name}</p><p class="mt-1 text-xs text-on-surface-variant">{customer.daysOverdue} días de mora · {customer.phone}</p></div></div><div class="flex items-center gap-4"><div class="text-right"><p class="font-bold text-error">{formatCurrency(customer.balance)}</p><p class="text-xs text-on-surface-variant">Saldo vencido</p></div><a href={`https://wa.me/${customer.phone.replace(/\D/g, '')}`} class="grid h-10 w-10 place-items-center rounded-full bg-secondary-container text-on-secondary-container" aria-label={`Contactar a ${customer.name} por WhatsApp`}><span class="material-symbols-outlined text-[20px]">chat</span></a></div></div>)}</div></section>
	</section>
</MainLayout>
