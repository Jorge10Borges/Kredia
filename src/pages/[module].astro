---
import MainLayout from '../layouts/MainLayout.astro';
import ConfirmationModal from '../components/ConfirmationModal.astro';
import { customers as mockCustomers, formatCurrency, lowStockProducts, recentSales } from '../data/mock';
import type { PurchaseAccount } from '../types/domain';

const moduleKey = Astro.params.module ?? 'dashboard';
const modules: Record<string, { title: string; eyebrow: string; description: string; primary: string }> = {
	ventas: { title: 'Ventas', eyebrow: 'Documentos comerciales', description: 'Emite documentos, registra pagos y mantén el pulso de tus ventas.', primary: 'Nueva venta' },
	compras: { title: 'Compras', eyebrow: 'Abastecimiento', description: 'Controla proveedores, facturas de entrada y reposición de inventario.', primary: 'Registrar compra' },
	clientes: { title: 'Clientes', eyebrow: 'Directorio comercial', description: 'Consulta contactos, límites de crédito y saldos pendientes.', primary: 'Nuevo cliente' },
	proveedores: { title: 'Proveedores', eyebrow: 'Directorio de abastecimiento', description: 'Centraliza tus aliados comerciales y sus cuentas por pagar.', primary: 'Nuevo proveedor' },
	credito: { title: 'Crédito y cobranzas', eyebrow: 'Cuentas por cobrar', description: 'Haz seguimiento a vencimientos, abonos y clientes en mora.', primary: 'Registrar cobro' },
	caja: { title: 'Caja Express', eyebrow: 'Control diario', description: 'Revisa movimientos, medios de pago y el cierre de tu jornada.', primary: 'Registrar movimiento' },
	reportes: { title: 'Reportes', eyebrow: 'Información para decidir', description: 'Convierte tus operaciones en una lectura clara del negocio.', primary: 'Exportar CSV' },
};
export function getStaticPaths() {
	return ['ventas', 'compras', 'clientes', 'proveedores', 'credito', 'caja', 'reportes'].map((module) => ({ params: { module } }));
}
const page = modules[moduleKey] ?? modules.ventas;
const isCredit = moduleKey === 'credito';
const isCustomers = moduleKey === 'clientes';
const isProviders = moduleKey === 'proveedores';
const isPurchases = moduleKey === 'compras';
const isSales = moduleKey === 'ventas';
const showCustomerContact = !isCustomers;
const purchaseAccounts: PurchaseAccount[] = [];
const customers = isCustomers ? [] : mockCustomers;
---

<MainLayout title={page.title}>
	<section class="mx-auto w-full max-w-3xl space-y-6 px-4 pb-4 pt-5 sm:px-6 md:max-w-none md:px-8 md:pt-8">
		<div class="mb-8 flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-forest">{page.eyebrow}</p><h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">{page.title}</h2><p class="mt-2 max-w-xl text-sm leading-6 text-muted">{page.description}</p></div>{(isCustomers || isProviders) ? <a href={isCustomers ? '/clientes/nuevo' : '/proveedores/nuevo'} class="rounded-xl bg-forest px-4 py-2.5 text-center text-sm font-bold text-white transition hover:bg-[#164737]">{page.primary} <span class="ml-1 text-base">+</span></a> : <button id="primary-action" class="rounded-xl bg-forest px-4 py-2.5 text-sm font-bold text-white transition hover:bg-[#164737]">{page.primary} <span class="ml-1 text-base">+</span></button>}</div>
		{isPurchases && <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4"><a href="/compras/estado-de-cuenta" class="flex items-center gap-3 rounded-xl border border-outline-variant bg-surface-container-lowest px-4 py-3 text-on-surface transition-colors hover:border-secondary hover:bg-surface-container-low"><span class="grid h-9 w-9 place-items-center rounded-lg bg-secondary-container text-on-secondary-container"><span class="material-symbols-outlined text-[20px]">receipt_long</span></span><span><strong class="block text-sm font-bold text-primary">Estado de cuenta</strong><span class="block text-xs text-on-surface-variant">Facturas, pagos y saldos</span></span><span class="material-symbols-outlined ml-auto text-on-surface-variant">arrow_forward</span></a><a href="/compras/historico-pagos" class="flex items-center gap-3 rounded-xl border border-outline-variant bg-surface-container-lowest px-4 py-3 text-on-surface transition-colors hover:border-secondary hover:bg-surface-container-low"><span class="grid h-9 w-9 place-items-center rounded-lg bg-surface-container text-primary"><span class="material-symbols-outlined text-[20px]">history</span></span><span><strong class="block text-sm font-bold text-primary">Histórico de pagos</strong><span class="block text-xs text-on-surface-variant">Abonos a proveedores</span></span><span class="material-symbols-outlined ml-auto text-on-surface-variant">arrow_forward</span></a><a href="/compras/alertas" class="flex items-center gap-3 rounded-xl border border-outline-variant bg-surface-container-lowest px-4 py-3 text-on-surface transition-colors hover:border-error hover:bg-error-container"><span class="grid h-9 w-9 place-items-center rounded-lg bg-error-container text-on-error-container"><span class="material-symbols-outlined text-[20px]">notifications_active</span></span><span><strong class="block text-sm font-bold text-primary">Alertas de compras</strong><span class="block text-xs text-on-surface-variant">Crédito vencido por pagar</span></span><span class="material-symbols-outlined ml-auto text-on-surface-variant">arrow_forward</span></a><a href="/reportes" class="flex items-center gap-3 rounded-xl border border-outline-variant bg-surface-container-lowest px-4 py-3 text-on-surface transition-colors hover:border-secondary hover:bg-surface-container-low"><span class="grid h-9 w-9 place-items-center rounded-lg bg-surface-container text-primary"><span class="material-symbols-outlined text-[20px]">bar_chart</span></span><span><strong class="block text-sm font-bold text-primary">Reportes de compras</strong><span class="block text-xs text-on-surface-variant">Analizar compras y pagos</span></span><span class="material-symbols-outlined ml-auto text-on-surface-variant">arrow_forward</span></a></div>}
		{isSales && <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4"><a href="/credito" class="flex items-center gap-3 rounded-xl border border-outline-variant bg-surface-container-lowest px-4 py-3 text-on-surface transition-colors hover:border-secondary hover:bg-surface-container-low"><span class="grid h-9 w-9 place-items-center rounded-lg bg-secondary-container text-on-secondary-container"><span class="material-symbols-outlined text-[20px]">receipt_long</span></span><span><strong class="block text-sm font-bold text-primary">Estado de cuenta</strong><span class="block text-xs text-on-surface-variant">Facturas, pagos y saldos</span></span><span class="material-symbols-outlined ml-auto text-on-surface-variant">arrow_forward</span></a><a href="/ventas/historico-pagos" class="flex items-center gap-3 rounded-xl border border-outline-variant bg-surface-container-lowest px-4 py-3 text-on-surface transition-colors hover:border-secondary hover:bg-surface-container-low"><span class="grid h-9 w-9 place-items-center rounded-lg bg-surface-container text-primary"><span class="material-symbols-outlined text-[20px]">history</span></span><span><strong class="block text-sm font-bold text-primary">Histórico de pagos</strong><span class="block text-xs text-on-surface-variant">Cobros y abonos recibidos</span></span><span class="material-symbols-outlined ml-auto text-on-surface-variant">arrow_forward</span></a><a href="/ventas/alertas" class="flex items-center gap-3 rounded-xl border border-outline-variant bg-surface-container-lowest px-4 py-3 text-on-surface transition-colors hover:border-error hover:bg-error-container"><span class="grid h-9 w-9 place-items-center rounded-lg bg-error-container text-on-error-container"><span class="material-symbols-outlined text-[20px]">notifications_active</span></span><span><strong class="block text-sm font-bold text-primary">Alertas de ventas</strong><span class="block text-xs text-on-surface-variant">Crédito de clientes vencido</span></span><span class="material-symbols-outlined ml-auto text-on-surface-variant">arrow_forward</span></a><a href="/reportes" class="flex items-center gap-3 rounded-xl border border-outline-variant bg-surface-container-lowest px-4 py-3 text-on-surface transition-colors hover:border-secondary hover:bg-surface-container-low"><span class="grid h-9 w-9 place-items-center rounded-lg bg-surface-container text-primary"><span class="material-symbols-outlined text-[20px]">bar_chart</span></span><span><strong class="block text-sm font-bold text-primary">Reportes de ventas</strong><span class="block text-xs text-on-surface-variant">Analizar ventas y cobros</span></span><span class="material-symbols-outlined ml-auto text-on-surface-variant">arrow_forward</span></a></div>}
		<div class="mb-6 grid gap-4 sm:grid-cols-3"><div class="rounded-2xl border border-line bg-white p-5"><p class="text-sm text-muted">{isCredit ? 'Saldo pendiente' : isCustomers ? 'Clientes activos' : isPurchases ? 'Compras del mes' : 'Operaciones del mes'}</p><p class="mt-4 font-display text-2xl font-bold text-ink">{isCredit ? formatCurrency(12780.25) : isCustomers ? '128' : isPurchases ? formatCurrency(purchaseAccounts.reduce((sum, account) => sum + account.total, 0)) : '184'}</p><p class="mt-2 text-xs font-bold text-forest">{isPurchases ? `${purchaseAccounts.length} documentos reales` : '+8.2% este periodo'}</p></div><div class="rounded-2xl border border-line bg-white p-5"><p class="text-sm text-muted">{isCredit ? 'Clientes en mora' : isCustomers ? 'Con crédito activo' : isPurchases ? 'Saldo por pagar' : 'Pendientes'}</p><p class="mt-4 font-display text-2xl font-bold text-ink">{isCredit ? '3' : isCustomers ? '42' : isPurchases ? formatCurrency(purchaseAccounts.reduce((sum, account) => sum + account.total - account.paid, 0)) : '8'}</p><p class="mt-2 text-xs text-muted">{isPurchases ? 'Desde la base de datos' : 'Requieren seguimiento'}</p></div><div class="rounded-2xl border border-line bg-white p-5"><p class="text-sm text-muted">Última actualización</p><p class="mt-4 font-display text-2xl font-bold text-ink">11:30 am</p><p class="mt-2 text-xs text-muted">Hoy, 25 de agosto</p></div></div>
		<div class="overflow-hidden rounded-2xl border border-line bg-white"><div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-5 py-5 sm:px-6"><div><h3 class="font-display text-lg font-bold text-ink">{isCredit ? 'Cuentas que requieren atención' : isCustomers ? 'Directorio de clientes' : isProviders ? 'Directorio de proveedores' : isPurchases ? 'Compras recientes' : 'Actividad reciente'}</h3><p class="mt-1 text-xs text-muted">{isPurchases ? 'Datos cargados desde MySQL' : isProviders ? '' : 'Datos de demostración del MVP'}</p></div><div class="flex gap-2"><input class="w-32 rounded-lg border border-line px-3 py-2 text-xs outline-none focus:border-forest sm:w-44" type="search" placeholder="Buscar..." aria-label="Buscar en el módulo" /><button id="filter-action" class="rounded-lg border border-line px-3 py-2 text-xs font-bold text-ink">Filtrar</button></div></div>
		{isPurchases && purchaseAccounts.length === 0 && <div class="flex flex-col items-center gap-2 px-6 py-12 text-center"><span class="material-symbols-outlined text-4xl text-on-surface-variant">inventory</span><p class="font-bold text-primary">No hay compras registradas</p><p class="text-sm text-on-surface-variant">Cuando registres una compra en MySQL aparecerá aquí.</p></div>}
		{isProviders && <div id="providers-directory" class="overflow-x-auto"><table class="w-full min-w-162.5 text-left"><thead class="bg-paper text-[10px] uppercase tracking-[0.15em] text-muted"><tr><th class="px-5 py-3 font-bold sm:px-6">Proveedor</th><th class="px-5 py-3 font-bold">Identificación fiscal</th><th class="px-5 py-3 font-bold">Plazo de pago</th><th class="px-5 py-3 font-bold">Estado</th><th class="px-5 py-3 text-right">Acciones</th></tr></thead><tbody id="providers-table-body"></tbody></table></div>}
			{isCustomers || isCredit ? <div class="overflow-x-auto"><table class="w-full min-w-162.5 text-left"><thead class="bg-paper text-[10px] uppercase tracking-[0.15em] text-muted"><tr><th class="px-5 py-3 font-bold sm:px-6">Cliente</th>{showCustomerContact && <th class="px-5 py-3 font-bold">Contacto</th>}<th class="px-5 py-3 font-bold">Límite</th><th class="px-5 py-3 font-bold">Saldo</th><th class="px-5 py-3 font-bold">Estado</th>{showCustomerContact && <th class="px-5 py-3"></th>}</tr></thead><tbody>{customers.map((customer) => <tr class="border-t border-line text-sm" data-customer-id={isCustomers ? customer.id : undefined}><td class="px-5 py-4 font-bold text-ink sm:px-6">{customer.name}</td>{showCustomerContact && <td class="px-5 py-4 text-muted">{customer.phone}</td>}<td class="px-5 py-4 text-muted">{formatCurrency(customer.creditLimit)}</td><td class="px-5 py-4 font-bold text-ink">{formatCurrency(customer.balance)}</td><td class="px-5 py-4"><span class:list={["rounded-full px-2.5 py-1 text-[11px] font-bold", customer.status === 'En mora' ? 'bg-[#fff0eb] text-coral' : customer.status === 'Por vencer' ? 'bg-[#fff6da] text-[#9a7419]' : 'bg-mint text-forest']}>{customer.status}</span></td>{showCustomerContact && <td class="px-5 py-4 text-right"><a href={`mailto:${customer.name.toLowerCase().replaceAll(' ', '.')}@correo.com`} class="text-xs font-bold text-forest">Contactar</a></td>}</tr>)}</tbody></table></div> : <div class:list={["divide-y divide-line", isProviders && "hidden"]}>{(isPurchases ? purchaseAccounts : recentSales).map((item) => <div class="flex flex-wrap items-center justify-between gap-4 px-5 py-5 sm:px-6"><div><p class="font-bold text-ink">{'supplier' in item ? item.supplier : item.id}</p><p class="mt-1 text-xs text-muted">{'supplier' in item ? `${item.id} · Vence ${item.dueDate}` : `${item.customer} · ${item.date}`}</p></div><div class="text-right"><p class="font-bold text-ink">{'supplier' in item ? formatCurrency(item.total - item.paid) : formatCurrency(item.total)}</p><span class="mt-1 inline-block rounded-full bg-mint px-2.5 py-1 text-[11px] font-bold text-forest">{'supplier' in item ? item.status : item.status}</span></div></div>)}</div>}
		</div>
		<div id="action-feedback" class="mt-5 hidden rounded-xl border border-[#b9dfc3] bg-mint px-4 py-3 text-sm font-bold text-forest">Acción simulada: el formulario estará conectado al backend propio en la siguiente fase.</div>
	</section>
	<ConfirmationModal />
</MainLayout>

<script>
	const apiBaseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
	document.querySelector('#primary-action')?.addEventListener('click', () => document.querySelector('#action-feedback')?.classList.remove('hidden'));
	const updateKpi = (label: string, value: string, note: string) => {
		const labelElement = Array.from(document.querySelectorAll('p')).find((element) => element.textContent?.trim() === label);
		const valueElement = labelElement?.nextElementSibling;
		const noteElement = valueElement?.nextElementSibling;

		if (valueElement) valueElement.textContent = value;
		if (noteElement) noteElement.textContent = note;
	};

	if (window.location.pathname.endsWith('/clientes') || window.location.pathname.endsWith('/clientes/')) {
		const directoryHeading = Array.from(document.querySelectorAll('h3')).find((element) => element.textContent?.trim() === 'Directorio de clientes');
		directoryHeading?.nextElementSibling?.remove();
		const table = document.querySelector('table');
		const headerRow = table?.querySelector('thead tr');
		const tableBody = table?.querySelector('tbody');
		const searchInput = document.querySelector<HTMLInputElement>('input[aria-label="Buscar en el módulo"]');
		const filterButton = document.querySelector<HTMLButtonElement>('#filter-action');
		const noResults = document.createElement('p');
		noResults.className = 'hidden px-5 py-6 text-center text-sm text-muted sm:px-6';
		noResults.textContent = 'No se encontraron clientes con esos criterios.';
		table?.parentElement?.append(noResults);

		if (headerRow && tableBody) {
			const actionsHeader = document.createElement('th');
			actionsHeader.className = 'px-5 py-3 text-right sm:px-6';
			actionsHeader.innerHTML = '<span class="sr-only">Acciones</span>';
			headerRow.append(actionsHeader);

			const filterCustomers = () => {
				const query = searchInput?.value.trim().toLocaleLowerCase('es-VE') ?? '';
				let visibleRows = 0;

				tableBody.querySelectorAll<HTMLTableRowElement>('tr').forEach((row) => {
					const matches = row.textContent?.toLocaleLowerCase('es-VE').includes(query) ?? false;
					row.hidden = !matches;
					if (matches) visibleRows += 1;
				});

				noResults.classList.toggle('hidden', visibleRows > 0);
			};

			searchInput?.addEventListener('input', filterCustomers);
			filterButton?.addEventListener('click', filterCustomers);

			document.addEventListener('confirmation-modal:confirm', async (event) => {
				const { id } = (event as CustomEvent<{ id: string }>).detail;
				if (!id) return;

				const response = await fetch(`${apiBaseUrl}api/clientes.php?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
				if (!response.ok) {
					window.alert('No se pudo eliminar el cliente. Inténtalo de nuevo.');
					return;
				}

				const deletedRow = tableBody.querySelector<HTMLTableRowElement>(`tr[data-customer-id="${CSS.escape(id)}"]`);
				deletedRow?.remove();
				filterCustomers();
			});

			const formatCurrency = (value: number) => new Intl.NumberFormat('es-VE', { style: 'currency', currency: 'USD' }).format(value);
			const status = (customer: { estado: string; estado_credito: string; dias_mora: number; saldo_pendiente: number }) => {
				if (customer.estado !== 'activo' || customer.estado_credito !== 'activo' || Number(customer.dias_mora) > 0) return 'En mora';
				return Number(customer.saldo_pendiente) > 0 ? 'Por vencer' : 'Al día';
			};
			const addActionButton = (icon: string, label: string, className: string, attributes: Record<string, string> = {}) => {
				const button = document.createElement('button');
				button.type = 'button'; button.className = className; button.title = label; button.setAttribute('aria-label', label);
				Object.entries(attributes).forEach(([name, value]) => button.dataset[name] = value);
				const symbol = document.createElement('span'); symbol.className = 'material-symbols-outlined text-[19px]'; symbol.textContent = icon; button.append(symbol);
				return button;
			};
			const renderCustomers = (customers: Array<{ id: string; nombre: string; limite_credito: number; saldo_pendiente: number; estado: string; estado_credito: string; dias_mora: number }>) => {
				tableBody.replaceChildren();
				customers.forEach((customer) => {
					const row = document.createElement('tr'); row.className = 'border-t border-line text-sm'; row.dataset.customerId = customer.id;
					const customerStatus = status(customer);
					const cells = [[customer.nombre, 'px-5 py-4 font-bold text-ink sm:px-6'], [formatCurrency(Number(customer.limite_credito)), 'px-5 py-4 text-muted'], [formatCurrency(Number(customer.saldo_pendiente)), 'px-5 py-4 font-bold text-ink']];
					cells.forEach(([text, className]) => { const cell = document.createElement('td'); cell.className = className; cell.textContent = text; row.append(cell); });
					const statusCell = document.createElement('td'); statusCell.className = 'px-5 py-4'; const badge = document.createElement('span'); badge.className = customerStatus === 'En mora' ? 'rounded-full bg-[#fff0eb] px-2.5 py-1 text-[11px] font-bold text-coral' : customerStatus === 'Por vencer' ? 'rounded-full bg-[#fff6da] px-2.5 py-1 text-[11px] font-bold text-[#9a7419]' : 'rounded-full bg-mint px-2.5 py-1 text-[11px] font-bold text-forest'; badge.textContent = customerStatus; statusCell.append(badge); row.append(statusCell);
					const actionsCell = document.createElement('td'); actionsCell.className = 'px-5 py-4 sm:px-6'; const actions = document.createElement('div'); actions.className = 'flex justify-end gap-1'; const editButton = addActionButton('edit', `Editar ${customer.nombre}`, 'grid h-8 w-8 place-items-center rounded-lg text-forest transition hover:bg-mint'); editButton.addEventListener('click', () => { window.location.assign(`${apiBaseUrl}clientes/nuevo?id=${encodeURIComponent(customer.id)}`); }); actions.append(editButton, addActionButton('delete', `Eliminar ${customer.nombre}`, 'grid h-8 w-8 place-items-center rounded-lg text-coral transition hover:bg-[#fff0eb]', { confirmDelete: '', customerId: customer.id, customerName: customer.nombre, confirmDescription: `Eliminarás lógicamente a ${customer.nombre} y sus datos asociados. Podrás restaurarlo posteriormente.` })); actionsCell.append(actions); row.append(actionsCell); tableBody.append(row);
				});
				filterCustomers();
			};
			fetch(`${apiBaseUrl}api/clientes.php`).then((response) => response.ok ? response.json() : Promise.reject()).then((data) => {
				renderCustomers(data.customers);
				updateKpi('Clientes activos', String(data.kpis.active_customers), `${data.kpis.total_customers} registrados`);
				updateKpi('Con crédito activo', String(data.kpis.active_credits), 'Con condiciones vigentes');
				const updated = data.kpis.last_updated ? new Date(data.kpis.last_updated) : null;
				updateKpi('Última actualización', updated ? new Intl.DateTimeFormat('es-VE', { hour: '2-digit', minute: '2-digit', hour12: true }).format(updated) : 'Sin registros', updated ? new Intl.DateTimeFormat('es-VE', { day: '2-digit', month: 'long', year: 'numeric' }).format(updated) : 'No hay ubicaciones registradas');
			}).catch(() => { noResults.textContent = 'No fue posible cargar los clientes.'; noResults.classList.remove('hidden'); });
		}
	}

	if (window.location.pathname.endsWith('/proveedores') || window.location.pathname.endsWith('/proveedores/')) {
		const table = document.querySelector<HTMLTableElement>('#providers-directory table');
		const tableBody = document.querySelector<HTMLTableSectionElement>('#providers-table-body');
		const searchInput = document.querySelector<HTMLInputElement>('input[aria-label="Buscar en el módulo"]');
		const filterButton = document.querySelector<HTMLButtonElement>('#filter-action');
		const noResults = document.createElement('p');
		noResults.className = 'hidden px-5 py-6 text-center text-sm text-muted sm:px-6';
		noResults.textContent = 'No se encontraron proveedores con esos criterios.';
		table?.parentElement?.append(noResults);

		const filterSuppliers = () => {
			const query = searchInput?.value.trim().toLocaleLowerCase('es-VE') ?? '';
			let visibleRows = 0;
			tableBody?.querySelectorAll<HTMLTableRowElement>('tr').forEach((row) => {
				const matches = row.textContent?.toLocaleLowerCase('es-VE').includes(query) ?? false;
				row.hidden = !matches;
				if (matches) visibleRows += 1;
			});
			noResults.classList.toggle('hidden', visibleRows > 0);
		};

		const renderSuppliers = (suppliers: Array<{ id: number; nombre: string; identificacion_fiscal: string; dias_plazo: number; estado: string }>) => {
			if (!tableBody) return;
			tableBody.replaceChildren();
			suppliers.forEach((supplier) => {
				const row = document.createElement('tr');
				row.className = 'border-t border-line text-sm';
				row.dataset.supplierId = String(supplier.id);
				const nameCell = document.createElement('td'); nameCell.className = 'px-5 py-4 font-bold text-ink sm:px-6'; nameCell.textContent = supplier.nombre;
				const taxCell = document.createElement('td'); taxCell.className = 'px-5 py-4 text-muted'; taxCell.textContent = supplier.identificacion_fiscal;
				const termCell = document.createElement('td'); termCell.className = 'px-5 py-4 text-muted'; termCell.textContent = `${supplier.dias_plazo} días`;
				const stateCell = document.createElement('td'); stateCell.className = 'px-5 py-4'; const badge = document.createElement('span'); badge.className = supplier.estado === 'activo' ? 'rounded-full bg-mint px-2.5 py-1 text-[11px] font-bold text-forest' : 'rounded-full bg-[#edf1f0] px-2.5 py-1 text-[11px] font-bold text-muted'; badge.textContent = supplier.estado === 'activo' ? 'Activo' : 'Inactivo'; stateCell.append(badge);
				const actionsCell = document.createElement('td'); actionsCell.className = 'px-5 py-4 sm:px-6'; const actions = document.createElement('div'); actions.className = 'flex justify-end gap-1';
				const editButton = document.createElement('button'); editButton.type = 'button'; editButton.className = 'grid h-8 w-8 place-items-center rounded-lg text-forest transition hover:bg-mint'; editButton.title = `Editar ${supplier.nombre}`; editButton.setAttribute('aria-label', `Editar ${supplier.nombre}`); editButton.addEventListener('click', () => { window.location.assign(`${apiBaseUrl}proveedores/nuevo?id=${encodeURIComponent(supplier.id)}`); }); const editIcon = document.createElement('span'); editIcon.className = 'material-symbols-outlined text-[19px]'; editIcon.textContent = 'edit'; editButton.append(editIcon);
				const deleteButton = document.createElement('button'); deleteButton.type = 'button'; deleteButton.className = 'grid h-8 w-8 place-items-center rounded-lg text-coral transition hover:bg-[#fff0eb]'; deleteButton.title = `Eliminar ${supplier.nombre}`; deleteButton.setAttribute('aria-label', `Eliminar ${supplier.nombre}`); deleteButton.dataset.confirmDelete = ''; deleteButton.dataset.customerId = String(supplier.id); deleteButton.dataset.customerName = supplier.nombre; deleteButton.dataset.confirmDescription = `Eliminarás lógicamente a ${supplier.nombre}.`;
				const deleteIcon = document.createElement('span'); deleteIcon.className = 'material-symbols-outlined text-[19px]'; deleteIcon.textContent = 'delete'; deleteButton.append(deleteIcon); actions.append(editButton, deleteButton); actionsCell.append(actions);
				row.append(nameCell, taxCell, termCell, stateCell, actionsCell); tableBody.append(row);
			});
			filterSuppliers();
		};

		searchInput?.addEventListener('input', filterSuppliers);
		filterButton?.addEventListener('click', filterSuppliers);
		document.addEventListener('confirmation-modal:confirm', async (event) => {
			const { id } = (event as CustomEvent<{ id: string }>).detail;
			if (!id) return;
			const response = await fetch(`${apiBaseUrl}api/proveedores.php?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
			if (!response.ok) { window.alert('No se pudo eliminar el proveedor. Inténtalo de nuevo.'); return; }
			tableBody?.querySelector<HTMLTableRowElement>(`tr[data-supplier-id="${CSS.escape(id)}"]`)?.remove();
			filterSuppliers();
		});

		fetch(`${apiBaseUrl}api/proveedores.php`).then((response) => response.ok ? response.json() : Promise.reject()).then((data) => {
			renderSuppliers(data.suppliers);
			updateKpi('Operaciones del mes', String(data.kpis.active_suppliers), `${data.kpis.total_suppliers} registrados`);
			updateKpi('Pendientes', String(data.kpis.total_suppliers - data.kpis.active_suppliers), 'Inactivos');
			const updated = data.kpis.last_updated ? new Date(data.kpis.last_updated) : null;
			updateKpi('Última actualización', updated ? new Intl.DateTimeFormat('es-VE', { hour: '2-digit', minute: '2-digit', hour12: true }).format(updated) : 'Sin registros', updated ? new Intl.DateTimeFormat('es-VE', { day: '2-digit', month: 'long', year: 'numeric' }).format(updated) : 'No hay proveedores registrados');
		}).catch(() => { noResults.textContent = 'No fue posible cargar los proveedores.'; noResults.classList.remove('hidden'); });
	}
</script>