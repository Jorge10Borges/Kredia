---
import MainLayout from '../../layouts/MainLayout.astro';
import ConfirmationModal from '../../components/ConfirmationModal.astro';
---

<MainLayout title="Pedidos">
  <section class="mx-auto w-full max-w-6xl px-4 pb-8 pt-5 sm:px-6 md:px-8 md:pt-8">
    <div class="mb-8 flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-forest">Atención al cliente</p><h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">Pedidos</h2><p class="mt-2 max-w-xl text-sm leading-6 text-muted">Organiza solicitudes, entregas y estados de cada pedido.</p></div><a href="/pedidos/nuevo" class="rounded-xl bg-forest px-4 py-2.5 text-center text-sm font-bold text-white transition hover:bg-[#164737]">Nuevo pedido <span class="ml-1 text-base">+</span></a></div>
    <div class="mb-6 grid gap-4 sm:grid-cols-3"><article class="rounded-2xl border border-line bg-white p-5"><p class="text-sm text-muted">Pedidos registrados</p><p id="orders-total" class="mt-4 font-display text-2xl font-bold text-ink">-</p><p class="mt-2 text-xs text-muted">Pedidos activos</p></article><article class="rounded-2xl border border-line bg-white p-5"><p class="text-sm text-muted">En proceso</p><p id="orders-open" class="mt-4 font-display text-2xl font-bold text-ink">-</p><p class="mt-2 text-xs text-muted">Pendientes de entrega</p></article><article class="rounded-2xl border border-line bg-white p-5"><p class="text-sm text-muted">Valor acumulado</p><p id="orders-value" class="mt-4 font-display text-2xl font-bold text-ink">-</p><p class="mt-2 text-xs text-muted">Total de pedidos</p></article></div>
    <section class="overflow-hidden rounded-2xl border border-line bg-white"><div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-5 py-5 sm:px-6"><div><h3 class="font-display text-lg font-bold text-ink">Directorio de pedidos</h3></div><div class="flex gap-2"><input id="order-search" class="w-36 rounded-lg border border-line px-3 py-2 text-xs outline-none focus:border-forest sm:w-48" type="search" placeholder="Buscar..." aria-label="Buscar pedidos" /><button id="order-filter" class="rounded-lg border border-line px-3 py-2 text-xs font-bold text-ink">Filtrar</button></div></div><div class="overflow-x-auto"><table class="w-full min-w-180 text-left"><thead class="bg-paper text-[10px] uppercase tracking-[0.15em] text-muted"><tr><th class="px-5 py-3 font-bold sm:px-6">Pedido</th><th class="px-5 py-3 font-bold">Cliente</th><th class="px-5 py-3 font-bold">Fecha</th><th class="px-5 py-3 font-bold">Entrega</th><th class="px-5 py-3 font-bold">Estado</th><th class="px-5 py-3 text-right font-bold">Total</th><th class="px-5 py-3 text-right font-bold">Acciones</th></tr></thead><tbody id="orders-table"></tbody></table></div><p id="orders-empty" class="hidden px-6 py-10 text-center text-sm text-muted"></p></section>
  </section>
  <ConfirmationModal />
</MainLayout>

<script>
  interface OrderRow { id: number; numero_pedido: string; cliente: string; fecha_pedido: string; fecha_entrega: string | null; estado: string; total: number; }
  interface OrderApiResponse { orders: OrderRow[]; kpis: { total_orders: number; open_orders: number; total_value: number; }; }
  const apiBaseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
  const currency = (value: number) => new Intl.NumberFormat('es-VE', { style: 'currency', currency: 'USD' }).format(Number(value));
  const body = document.querySelector<HTMLTableSectionElement>('#orders-table')!; const empty = document.querySelector<HTMLParagraphElement>('#orders-empty')!; const search = document.querySelector<HTMLInputElement>('#order-search')!; const filterButton = document.querySelector<HTMLButtonElement>('#order-filter')!;
  let orders: OrderRow[] = [];
  const filter = () => { const query = search.value.trim().toLocaleLowerCase('es-VE'); const visible = [...body.querySelectorAll('tr')].filter((row) => { const match = (row.textContent ?? '').toLocaleLowerCase('es-VE').includes(query); row.hidden = !match; return match; }).length; empty.classList.toggle('hidden', visible > 0); };
  const render = () => { body.replaceChildren(); orders.forEach((order) => { const row = document.createElement('tr'); row.className = 'border-t border-line text-sm'; row.dataset.orderId = String(order.id); row.innerHTML = `<td class="px-5 py-4 font-bold text-ink sm:px-6">${order.numero_pedido}</td><td class="px-5 py-4 text-muted">${order.cliente}</td><td class="px-5 py-4 text-muted">${new Date(order.fecha_pedido).toLocaleDateString('es-VE')}</td><td class="px-5 py-4 text-muted">${order.fecha_entrega ?? 'Por definir'}</td><td class="px-5 py-4"><span class="rounded-full bg-mint px-2.5 py-1 text-[11px] font-bold text-forest">${order.estado}</span></td><td class="px-5 py-4 text-right font-bold text-ink">${currency(order.total)}</td><td class="px-5 py-4"><div class="flex justify-end gap-1"><button type="button" data-confirm-delete data-customer-id="${order.id}" data-customer-name="${order.numero_pedido}" data-confirm-description="Eliminarás lógicamente el pedido ${order.numero_pedido}." class="grid h-8 w-8 place-items-center rounded-lg text-coral hover:bg-[#fff0eb]" aria-label="Eliminar ${order.numero_pedido}" title="Eliminar"><span class="material-symbols-outlined text-[19px]">delete</span></button></div></td>`; body.append(row); }); filter(); };
  filterButton.addEventListener('click', filter); search.addEventListener('input', filter);
  document.addEventListener('confirmation-modal:confirm', async (event) => { const { id } = (event as CustomEvent<{ id: string }>).detail; const response = await fetch(`${apiBaseUrl}api/pedidos.php?id=${encodeURIComponent(id)}`, { method: 'DELETE' }); if (!response.ok) return window.alert('No se pudo eliminar el pedido.'); orders = orders.filter((order) => String(order.id) !== String(id)); render(); });
  fetch(`${apiBaseUrl}api/pedidos.php`).then((response) => response.json() as Promise<OrderApiResponse>).then((data) => { orders = data.orders; render(); const total = document.querySelector<HTMLElement>('#orders-total'); const open = document.querySelector<HTMLElement>('#orders-open'); const value = document.querySelector<HTMLElement>('#orders-value'); if (total) total.textContent = String(data.kpis.total_orders); if (open) open.textContent = String(data.kpis.open_orders); if (value) value.textContent = currency(data.kpis.total_value); }).catch(() => { if (empty) { empty.textContent = 'No fue posible cargar los pedidos.'; empty.classList.remove('hidden'); } });
</script>
