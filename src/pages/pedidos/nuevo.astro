---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Nuevo pedido">
  <section class="mx-auto w-full max-w-6xl px-4 pb-8 pt-5 sm:px-6 md:px-8 md:pt-8">
    <div class="sticky top-14 z-40 -mx-4 mb-8 flex flex-col justify-between gap-5 border-b border-outline-variant bg-surface px-4 py-4 sm:-mx-6 sm:flex-row sm:items-end sm:px-6 md:-mx-8 md:px-8"><div><a href="/pedidos" class="inline-flex items-center gap-1 text-xs font-bold text-forest"><span class="material-symbols-outlined text-base">arrow_back</span>Pedidos</a><p class="mb-2 mt-4 text-xs font-bold uppercase tracking-[0.2em] text-forest">Atención al cliente</p><h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">Nuevo pedido</h2><p class="mt-2 text-sm leading-6 text-muted">Registra el cliente, productos y fecha de entrega.</p></div><div class="flex gap-3"><a href="/pedidos" class="rounded-xl border border-line px-4 py-2.5 text-sm font-bold text-ink">Cancelar</a><button form="order-form" type="submit" class="rounded-xl bg-forest px-4 py-2.5 text-sm font-bold text-white">Guardar pedido</button></div></div>
    <form id="order-form" class="space-y-6" novalidate><fieldset class="rounded-2xl border border-line bg-white p-5 sm:p-6"><legend class="px-1 font-display text-lg font-bold text-ink">Información del pedido</legend><div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"><label class="text-sm font-bold text-ink">Cliente <span class="text-coral">*</span><select id="order-customer" required class="mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"><option value="">Cargando clientes...</option></select></label><label class="text-sm font-bold text-ink">Fecha de entrega<input id="order-delivery" type="date" class="mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm font-normal outline-none focus:border-forest" /></label><label class="text-sm font-bold text-ink">Estado <span class="text-coral">*</span><select id="order-status" required class="mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"><option value="pendiente">Pendiente</option><option value="confirmado">Confirmado</option><option value="preparando">Preparando</option></select></label><label class="text-sm font-bold text-ink sm:col-span-2 lg:col-span-3">Notas<textarea id="order-notes" rows="2" maxlength="1000" class="mt-2 w-full resize-y rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"></textarea></label></div></fieldset><fieldset class="rounded-2xl border border-line bg-white p-5 sm:p-6"><legend class="px-1 font-display text-lg font-bold text-ink">Productos</legend><div class="mt-5 overflow-x-auto"><table class="w-full min-w-180 text-left"><thead class="bg-paper text-[10px] uppercase tracking-[0.15em] text-muted"><tr><th class="px-3 py-3">Producto</th><th class="px-3 py-3">Cantidad</th><th class="px-3 py-3">Precio</th><th class="px-3 py-3">IVA</th><th class="px-3 py-3 text-right">Subtotal</th><th class="px-3 py-3"></th></tr></thead><tbody id="order-lines"></tbody></table></div><button id="add-line" type="button" class="mt-4 inline-flex items-center gap-2 rounded-lg border border-line px-3 py-2 text-xs font-bold text-ink hover:border-forest hover:text-forest"><span class="material-symbols-outlined text-[18px]">add</span>Agregar producto</button></fieldset><div class="flex justify-end"><div class="w-full max-w-sm space-y-3 rounded-2xl border border-line bg-white p-5 text-sm"><div class="flex justify-between"><span class="text-muted">Subtotal</span><strong id="order-subtotal">$0.00</strong></div><div class="flex justify-between"><span class="text-muted">Impuesto (16%)</span><strong id="order-tax">$0.00</strong></div><div class="flex justify-between border-t border-line pt-3 text-base"><span class="font-bold">Total</span><strong id="order-total" class="text-forest">$0.00</strong></div></div></div><div id="order-feedback" class="hidden rounded-xl border px-4 py-3 text-sm font-bold" role="status" aria-live="polite"></div></form>
  </section>
  <dialog id="product-modal" class="fixed inset-0 m-auto h-fit w-[calc(100%-2rem)] max-w-lg rounded-xl border border-line bg-white p-0 text-ink shadow-2xl backdrop:bg-black/40"><form id="product-form" class="p-6"><div class="flex items-start justify-between gap-4"><div><h2 id="product-modal-title" class="font-display text-lg font-bold">Agregar producto</h2><p class="mt-1 text-sm text-muted">Selecciona el producto y la cantidad solicitada.</p></div><button id="modal-close" type="button" class="grid h-8 w-8 place-items-center rounded-lg text-muted hover:bg-paper" aria-label="Cerrar modal"><span class="material-symbols-outlined">close</span></button></div><div class="mt-6 grid gap-4 sm:grid-cols-2"><div class="relative sm:col-span-2"><label for="modal-product-search" class="text-sm font-bold text-ink">Buscar producto <span class="text-coral">*</span></label><input id="modal-product-search" required type="search" autocomplete="off" placeholder="Escribe el nombre del producto..." aria-controls="product-suggestions" aria-autocomplete="list" class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest" /><div id="product-suggestions" role="listbox" class="absolute left-0 right-0 top-full z-10 mt-1 hidden max-h-52 overflow-y-auto rounded-lg border border-line bg-white p-1 shadow-lg"></div></div><label class="text-sm font-bold text-ink">Cantidad <span class="text-coral">*</span><input id="modal-quantity" required type="number" min="0.5" step="0.5" value="1" class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest" /></label><label class="text-sm font-bold text-ink">Precio sugerido <span class="text-coral">*</span><input id="modal-price" required type="number" min="0" step="0.01" value="0" class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest" /></label></div><div class="mt-6 flex justify-end gap-3"><button id="modal-cancel" type="button" class="rounded-lg border border-line px-4 py-2.5 text-sm font-bold text-ink">Cancelar</button><button id="modal-submit" type="submit" class="rounded-lg bg-forest px-4 py-2.5 text-sm font-bold text-white">Agregar producto</button></div></form></dialog>
</MainLayout>

<script>
  interface Product { id: number; nombre: string; precio_venta: number; lleva_iva: number; }
  interface OrderDetail { productoId: string; cantidad: number; precioUnitario: number; descuento: number; }
  interface CatalogResponse { customers: Array<{ id: string; nombre: string }>; products: Product[]; }
  const apiBaseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
  const form = document.querySelector<HTMLFormElement>('#order-form')!;
  const customerSelect = document.querySelector<HTMLSelectElement>('#order-customer')!;
  const lines = document.querySelector<HTMLTableSectionElement>('#order-lines')!;
  const modal = document.querySelector<HTMLDialogElement>('#product-modal')!;
  const modalForm = document.querySelector<HTMLFormElement>('#product-form')!;
  const modalTitle = document.querySelector<HTMLElement>('#product-modal-title')!;
  const modalSubmit = document.querySelector<HTMLButtonElement>('#modal-submit')!;
  const search = document.querySelector<HTMLInputElement>('#modal-product-search')!;
  const suggestions = document.querySelector<HTMLDivElement>('#product-suggestions')!;
  const quantity = document.querySelector<HTMLInputElement>('#modal-quantity')!;
  const price = document.querySelector<HTMLInputElement>('#modal-price')!;
  const currency = (value: number) => new Intl.NumberFormat('es-VE', { style: 'currency', currency: 'USD' }).format(value);
  let products: Product[] = [];
  let selectedProduct: Product | null = null;
  let editingRow: HTMLTableRowElement | null = null;
  const recalculate = () => { let subtotal = 0; let tax = 0; lines.querySelectorAll<HTMLTableRowElement>('tr').forEach((row) => { const lineSubtotal = Number(row.dataset.subtotal ?? 0); subtotal += lineSubtotal; if (row.dataset.includesVat === 'true') tax += lineSubtotal * 0.16; }); document.querySelector<HTMLElement>('#order-subtotal')!.textContent = currency(subtotal); document.querySelector<HTMLElement>('#order-tax')!.textContent = currency(tax); document.querySelector<HTMLElement>('#order-total')!.textContent = currency(subtotal + tax); };
  const closeModal = () => modal.close('cancel');
  const normalizeSearch = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('es-VE');
  const renderSuggestions = () => { const query = normalizeSearch(search.value.trim()); suggestions.replaceChildren(); if (!query) return suggestions.classList.add('hidden'); const matches = products.filter((product) => normalizeSearch(product.nombre).includes(query)).slice(0, 8); matches.forEach((product) => { const item = document.createElement('button'); item.type = 'button'; item.role = 'option'; item.className = 'flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-sm hover:bg-mint'; item.textContent = product.nombre; item.addEventListener('click', () => { selectedProduct = product; search.value = product.nombre; suggestions.classList.add('hidden'); price.value = String(product.precio_venta); }); suggestions.append(item); }); suggestions.classList.toggle('hidden', matches.length === 0); };
  const addLine = (product: Product, itemQuantity: number, itemPrice: number, itemDiscount: number) => { const subtotal = Math.max(0, itemQuantity * itemPrice - itemDiscount); const includesVat = Number(product.lleva_iva) === 1; const row = document.createElement('tr'); row.className = 'border-t border-line text-sm'; row.dataset.productId = String(product.id); row.dataset.price = String(itemPrice); row.dataset.subtotal = String(subtotal); row.dataset.quantity = String(itemQuantity); row.dataset.discount = String(itemDiscount); row.dataset.includesVat = String(includesVat); row.innerHTML = `<td class="px-3 py-3 font-bold text-ink">${product.nombre}</td><td class="px-3 py-3 text-muted">${itemQuantity}</td><td class="px-3 py-3 text-muted">${currency(itemPrice)}</td><td class="px-3 py-3"><span class="rounded-full px-2.5 py-1 text-[11px] font-bold ${includesVat ? 'bg-mint text-forest' : 'bg-paper text-muted'}">${includesVat ? '16%' : 'Exento'}</span></td><td class="px-3 py-3 text-right font-bold">${currency(subtotal)}</td><td class="px-3 py-3 text-right"><div class="flex justify-end gap-1"><button type="button" class="edit-line grid h-8 w-8 place-items-center rounded-lg text-forest hover:bg-mint" aria-label="Editar ${product.nombre}" title="Editar producto"><span class="material-symbols-outlined text-[19px]">edit</span></button><button type="button" class="remove-line grid h-8 w-8 place-items-center rounded-lg text-coral hover:bg-[#fff0eb]" aria-label="Quitar ${product.nombre}" title="Quitar producto"><span class="material-symbols-outlined text-[19px]">delete</span></button></div></td>`; row.querySelector<HTMLButtonElement>('.edit-line')!.addEventListener('click', () => { editingRow = row; selectedProduct = product; search.value = product.nombre; quantity.value = String(itemQuantity); price.value = String(itemPrice); modalTitle.textContent = 'Editar producto'; modalSubmit.textContent = 'Actualizar producto'; modal.showModal(); }); row.querySelector<HTMLButtonElement>('.remove-line')!.addEventListener('click', () => { row.remove(); recalculate(); }); lines.append(row); recalculate(); };
  document.querySelector<HTMLButtonElement>('#add-line')!.addEventListener('click', () => { modalForm.reset(); editingRow = null; selectedProduct = null; modalTitle.textContent = 'Agregar producto'; modalSubmit.textContent = 'Agregar producto'; price.value = '0'; suggestions.classList.add('hidden'); modal.showModal(); search.focus(); });
  document.querySelector<HTMLButtonElement>('#modal-close')!.addEventListener('click', closeModal); document.querySelector<HTMLButtonElement>('#modal-cancel')!.addEventListener('click', closeModal);
  search.addEventListener('input', () => { selectedProduct = null; search.setCustomValidity(''); price.value = '0'; renderSuggestions(); });
  modalForm.addEventListener('submit', (event) => { event.preventDefault(); if (!selectedProduct) { search.setCustomValidity('Selecciona un producto de las sugerencias.'); search.reportValidity(); return; } search.setCustomValidity(''); if (!modalForm.checkValidity()) return modalForm.reportValidity(); const rowToReplace = editingRow; addLine(selectedProduct, Number(quantity.value), Number(price.value), 0); const replacementRow = lines.lastElementChild; if (rowToReplace && replacementRow) rowToReplace.replaceWith(replacementRow); editingRow = null; recalculate(); modal.close('confirm'); });
  modal.addEventListener('close', () => { if (modal.returnValue !== 'confirm') { modalForm.reset(); editingRow = null; selectedProduct = null; suggestions.classList.add('hidden'); } });
  fetch(`${apiBaseUrl}api/pedidos.php`).then((response) => response.json() as Promise<CatalogResponse>).then((data) => { data.customers.forEach((customer) => { const option = document.createElement('option'); option.value = customer.id; option.textContent = customer.nombre; customerSelect.append(option); }); customerSelect.querySelector('option')!.remove(); products = data.products; }).catch(() => { customerSelect.innerHTML = '<option value="">No fue posible cargar clientes</option>'; });
  form.addEventListener('submit', (event) => { event.preventDefault(); if (!form.checkValidity()) return form.reportValidity(); const details: OrderDetail[] = [...lines.querySelectorAll<HTMLTableRowElement>('tr')].map((row) => ({ productoId: row.dataset.productId ?? '', cantidad: Number(row.dataset.quantity), precioUnitario: Number(row.dataset.price), descuento: Number(row.dataset.discount) })); if (!details.length) return window.alert('Agrega al menos un producto válido.'); const payload = { clienteId: customerSelect.value, fechaEntrega: document.querySelector<HTMLInputElement>('#order-delivery')!.value, estado: document.querySelector<HTMLSelectElement>('#order-status')!.value, notas: document.querySelector<HTMLTextAreaElement>('#order-notes')!.value, detalles: details }; fetch(`${apiBaseUrl}api/pedidos.php`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) }).then(async (response) => { const data = await response.json().catch(() => ({})); if (!response.ok) throw new Error(data.message ?? 'No fue posible guardar el pedido.'); window.location.assign(`${apiBaseUrl}pedidos/`); }).catch((error: Error) => { const feedback = document.querySelector<HTMLElement>('#order-feedback')!; feedback.textContent = error.message; feedback.className = 'rounded-xl border border-[#ffdad6] bg-[#fff0eb] px-4 py-3 text-sm font-bold text-coral'; }); });
</script>
