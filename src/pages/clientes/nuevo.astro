---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout title="Nuevo cliente">
  <section class="mx-auto w-full max-w-5xl px-4 pb-8 pt-5 sm:px-6 md:px-8 md:pt-8">
    <div class="sticky top-14 z-40 -mx-4 mb-8 flex flex-col justify-between gap-5 border-b border-outline-variant bg-surface px-4 py-4 sm:-mx-6 sm:flex-row sm:items-end sm:px-6 md:-mx-8 md:px-8">
      <div>
        <a href="/clientes" class="inline-flex items-center gap-1 text-xs font-bold text-forest hover:text-[#164737]"
          ><span class="material-symbols-outlined text-base">arrow_back</span>Clientes</a
        ><p class="mb-2 mt-4 text-xs font-bold uppercase tracking-[0.2em] text-forest">Directorio comercial</p><h2
          class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
          Nuevo cliente
        </h2><p class="mt-2 text-sm leading-6 text-muted">Registra sus datos de identificación, ubicación y condiciones de crédito.</p>
      </div><div class="flex gap-3">
        <a href="/clientes" class="rounded-xl border border-line px-4 py-2.5 text-sm font-bold text-ink transition hover:border-forest hover:text-forest"
          >Cancelar</a
        ><button form="customer-form" type="submit" class="rounded-xl bg-forest px-4 py-2.5 text-sm font-bold text-white transition hover:bg-[#164737]"
          >Guardar cliente</button>
      </div>
    </div>

    <form id="customer-form" class="space-y-6" novalidate>
      <fieldset class="rounded-2xl border border-line bg-white p-5 sm:p-6">
        <legend class="px-1 font-display text-lg font-bold text-ink">Datos del cliente</legend><div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <label class="text-sm font-bold text-ink"
            >Tipo de persona<select
              name="tipoPersona"
              required
              class="mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"
              ><option value="natural">Natural</option><option value="juridica">Jurídica</option></select
            ></label
          ><label class="text-sm font-bold text-ink"
            >Nombre o razón social<input
              name="nombre"
              required
              maxlength="200"
              class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"
            /></label
          ><label class="text-sm font-bold text-ink"
            >Nombre comercial<input
              name="nombreComercial"
              maxlength="200"
              class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"
            /></label
          ><label class="text-sm font-bold text-ink"
            >Tipo de documento<select
              name="tipoDocumento"
              required
              class="mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"
              ><option value="cedula">Cédula</option><option value="rif">RIF</option><option value="pasaporte">Pasaporte</option><option value="otro"
                >Otro</option
              ></select
            ></label
          ><label class="text-sm font-bold text-ink"
            >Número de documento<input
              name="numeroDocumento"
              required
              maxlength="40"
              class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"
            /></label
          ><label class="text-sm font-bold text-ink"
            >Estado<select
              name="estado"
              required
              class="mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"
              ><option value="activo">Activo</option><option value="inactivo">Inactivo</option><option value="bloqueado">Bloqueado</option></select
            ></label
          ><label class="text-sm font-bold text-ink"
            >Teléfono principal<input
              name="telefonoPrincipal"
              required
              type="tel"
              maxlength="30"
              class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"
            /></label
          ><label class="text-sm font-bold text-ink"
            >Teléfono alternativo<input
              name="telefonoAlternativo"
              type="tel"
              maxlength="30"
              class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"
            /></label
          ><label class="text-sm font-bold text-ink"
            >Correo electrónico<input
              name="email"
              type="email"
              maxlength="254"
              class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"
            /></label>
        </div>
      </fieldset>

      <fieldset class="rounded-2xl border border-line bg-white p-5 sm:p-6">
        <legend class="px-1 font-display text-lg font-bold text-ink">Ubicación y contacto</legend><div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <label class="text-sm font-bold text-ink sm:col-span-2 lg:col-span-3"
            >Dirección fiscal<textarea
              name="direccionFiscal"
              required
              rows="2"
              maxlength="500"
              class="mt-2 w-full resize-y rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"></textarea></label
          ><label class="text-sm font-bold text-ink"
            >Ciudad<input
              name="ciudad"
              maxlength="100"
              class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"
            /></label
          ><label class="text-sm font-bold text-ink"
            >Estado o región<input
              name="estadoRegion"
              maxlength="100"
              class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"
            /></label
          ><label class="text-sm font-bold text-ink"
            >País<input
              name="pais"
              value="Venezuela"
              required
              maxlength="100"
              class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"
            /></label
          ><label class="text-sm font-bold text-ink"
            >Código postal<input
              name="codigoPostal"
              maxlength="20"
              class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"
            /></label
          ><label class="text-sm font-bold text-ink"
            >Persona de contacto<input
              name="personaContacto"
              maxlength="150"
              class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"
            /></label
          ><label class="text-sm font-bold text-ink"
            >Teléfono de contacto<input
              name="telefonoContacto"
              type="tel"
              maxlength="30"
              class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"
            /></label
          ><label class="text-sm font-bold text-ink"
            >Correo de contacto<input
              name="emailContacto"
              type="email"
              maxlength="254"
              class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"
            /></label>
        </div>
      </fieldset>

      <fieldset class="rounded-2xl border border-line bg-white p-5 sm:p-6">
        <legend class="px-1 font-display text-lg font-bold text-ink">Crédito y cobranza</legend><div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <label class="text-sm font-bold text-ink"
            >Límite de crédito<input
              name="limiteCredito"
              required
              type="number"
              min="0"
              step="0.01"
              value="0"
              class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"
            /></label
          ><label class="text-sm font-bold text-ink"
            >Días de crédito<input
              name="diasCredito"
              required
              type="number"
              min="0"
              max="365"
              step="1"
              value="0"
              class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"
            /></label
          ><label class="text-sm font-bold text-ink"
            >Estado del crédito<select
              name="estadoCredito"
              required
              class="mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"
              ><option value="activo">Activo</option><option value="suspendido">Suspendido</option><option value="bloqueado">Bloqueado</option></select
            ></label
          ><label class="text-sm font-bold text-ink sm:col-span-2 lg:col-span-3"
            >Notas de cobranza<textarea
              name="notasCobranza"
              rows="3"
              class="mt-2 w-full resize-y rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"></textarea></label>
        </div>
      </fieldset>

      <div id="form-feedback" class="hidden rounded-xl border px-4 py-3 text-sm font-bold" role="status" aria-live="polite"></div>
    </form>
  </section>
</MainLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#customer-form");
  const feedback = document.querySelector<HTMLElement>("#form-feedback");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (feedback) {
      feedback.textContent = "Los datos están listos para guardar. La conexión de guardado se habilitará al activar el backend SSR.";
      feedback.className = "rounded-xl border border-[#b9dfc3] bg-mint px-4 py-3 text-sm font-bold text-forest";
    }
  });
</script>
