---
import MainLayout from '../../layouts/MainLayout.astro';
import { formatCurrency, supplierPayments } from '../../data/mock';

const totalPaid = supplierPayments.reduce((sum, payment) => sum + payment.amount, 0);
---

<MainLayout title="Histórico de pagos">
	<section class="mx-auto w-full max-w-3xl space-y-6 px-4 pb-4 pt-5 sm:px-6 md:max-w-none md:px-8 md:pt-8">
		<div class="flex flex-col justify-between gap-5 md:flex-row md:items-end">
			<div>
				<a href="/compras" class="mb-4 inline-flex items-center gap-1 text-xs font-bold text-secondary hover:underline"><span class="material-symbols-outlined text-[17px]">arrow_back</span>Volver a compras</a>
				<p class="mb-2 text-label-caps text-secondary">Cuentas por pagar</p>
				<h2 class="font-display text-3xl font-bold tracking-tight text-primary sm:text-4xl">Histórico de pagos</h2>
				<p class="mt-2 max-w-xl text-sm leading-6 text-on-surface-variant">Consulta los abonos y pagos registrados a tus proveedores.</p>
			</div>
			<button id="export-button" class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-3 text-sm font-bold text-white transition-opacity hover:opacity-80"><span class="material-symbols-outlined text-[19px]">download</span>Exportar CSV</button>
		</div>

		<div class="grid gap-4 sm:grid-cols-3"><div class="rounded-xl border border-surface-variant bg-surface-container-lowest p-4"><p class="text-sm text-on-surface-variant">Pagos registrados</p><p class="mt-3 text-display-md font-bold text-primary">{supplierPayments.length}</p></div><div class="rounded-xl border border-surface-variant bg-surface-container-lowest p-4"><p class="text-sm text-on-surface-variant">Total abonado</p><p class="mt-3 text-display-md font-bold text-secondary">{formatCurrency(totalPaid)}</p></div><div class="rounded-xl border border-surface-variant bg-surface-container-lowest p-4"><p class="text-sm text-on-surface-variant">Último pago</p><p class="mt-3 text-display-md font-bold text-primary">20 ago 2026</p></div></div>

		<section class="overflow-hidden rounded-xl border border-surface-variant bg-surface-container-lowest"><div class="flex flex-wrap items-center justify-between gap-3 border-b border-surface-variant px-4 py-4 sm:px-5"><div><h3 class="text-headline-sm font-bold text-primary">Pagos a proveedores</h3><p class="mt-1 text-xs text-on-surface-variant">Historial de abonos y comprobantes registrados</p></div><input class="w-36 rounded-lg border border-outline-variant bg-surface px-3 py-2 text-xs outline-none focus:border-secondary sm:w-48" type="search" placeholder="Buscar proveedor..." aria-label="Buscar proveedor" /></div><div class="overflow-x-auto"><table class="w-full min-w-175 text-left"><thead class="bg-surface-container-low text-label-caps text-on-surface-variant"><tr><th class="px-4 py-3 font-semibold sm:px-5">Pago / proveedor</th><th class="px-4 py-3 font-semibold">Documento</th><th class="px-4 py-3 font-semibold">Fecha</th><th class="px-4 py-3 font-semibold">Método</th><th class="px-4 py-3 font-semibold">Referencia</th><th class="px-4 py-3 text-right font-semibold">Monto</th></tr></thead><tbody>{supplierPayments.map((payment) => <tr class="border-t border-surface-variant text-sm"><td class="px-4 py-4 sm:px-5"><p class="font-bold text-primary">{payment.supplier}</p><p class="mt-1 text-xs text-on-surface-variant">{payment.id}</p></td><td class="px-4 py-4 text-on-surface-variant">{payment.document}</td><td class="px-4 py-4 text-on-surface-variant">{payment.date}</td><td class="px-4 py-4 text-on-surface-variant">{payment.method}</td><td class="px-4 py-4 font-mono text-xs text-on-surface-variant">{payment.reference}</td><td class="px-4 py-4 text-right font-bold text-secondary">{formatCurrency(payment.amount)}</td></tr>)}</tbody></table></div></section>
	</section>
</MainLayout>

<script>
	document.querySelector('#export-button')?.addEventListener('click', () => {
		const link = document.createElement('a');
		link.href = 'data:text/csv;charset=utf-8,Proveedor,Documento,Fecha,Metodo,Referencia,Monto%0AAlimentos La Cosecha,OC-00124,20 ago 2026,Transferencia,TRX-884201,840';
		link.download = 'historico-pagos-compras.csv';
		link.click();
	});
</script>
