---
import MainLayout from '../layouts/MainLayout.astro';

const users = [
	{ initials: 'JG', name: 'Jorge García', email: 'jorge@kredia.local', role: 'Administrador', status: 'Activo', lastAccess: 'Hoy, 11:32 am' },
	{ initials: 'MC', name: 'María Contreras', email: 'maria@kredia.local', role: 'Cajero', status: 'Activo', lastAccess: 'Hoy, 09:18 am' },
	{ initials: 'RS', name: 'Ricardo Salas', email: 'ricardo@kredia.local', role: 'Cajero', status: 'Inactivo', lastAccess: '18 ago 2026' },
];
---

<MainLayout title="Seguridad">
	<section class="mx-auto w-full max-w-3xl space-y-6 px-4 pb-4 pt-5 sm:px-6 md:max-w-none md:px-8 md:pt-8">
		<div class="flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><p class="mb-2 text-label-caps text-secondary">Control de acceso</p><h2 class="font-display text-3xl font-bold tracking-tight text-primary sm:text-4xl">Seguridad</h2><p class="mt-2 max-w-xl text-sm leading-6 text-on-surface-variant">Administra usuarios y roles para proteger la operación de Kredia.</p></div><button id="new-user" class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-3 text-sm font-bold text-white transition-opacity hover:opacity-80"><span class="material-symbols-outlined text-[19px]">person_add</span>Nuevo usuario</button></div>
		<div class="grid gap-4 sm:grid-cols-3"><div class="rounded-xl border border-surface-variant bg-surface-container-lowest p-4"><p class="text-sm text-on-surface-variant">Usuarios registrados</p><p class="mt-3 text-display-md font-bold text-primary">{users.length}</p></div><div class="rounded-xl border border-surface-variant bg-surface-container-lowest p-4"><p class="text-sm text-on-surface-variant">Usuarios activos</p><p class="mt-3 text-display-md font-bold text-secondary">{users.filter((user) => user.status === 'Activo').length}</p></div><div class="rounded-xl border border-surface-variant bg-surface-container-lowest p-4"><p class="text-sm text-on-surface-variant">Roles disponibles</p><p class="mt-3 text-display-md font-bold text-primary">2</p></div></div>
		<section class="overflow-hidden rounded-xl border border-surface-variant bg-surface-container-lowest"><div class="flex flex-wrap items-center justify-between gap-3 border-b border-surface-variant px-4 py-4 sm:px-5"><div><h3 class="text-headline-sm font-bold text-primary">Usuarios del sistema</h3><p class="mt-1 text-xs text-on-surface-variant">Permisos simples: Administrador y Cajero</p></div><input class="w-36 rounded-lg border border-outline-variant bg-surface px-3 py-2 text-xs outline-none focus:border-secondary sm:w-48" type="search" placeholder="Buscar usuario..." aria-label="Buscar usuario" /></div><div class="overflow-x-auto"><table class="w-full min-w-175 text-left"><thead class="bg-surface-container-low text-label-caps text-on-surface-variant"><tr><th class="px-4 py-3 font-semibold sm:px-5">Usuario</th><th class="px-4 py-3 font-semibold">Rol</th><th class="px-4 py-3 font-semibold">Último acceso</th><th class="px-4 py-3 font-semibold">Estado</th><th class="px-4 py-3"></th></tr></thead><tbody>{users.map((user) => <tr class="border-t border-surface-variant text-sm"><td class="px-4 py-4 sm:px-5"><div class="flex items-center gap-3"><span class="grid h-9 w-9 place-items-center rounded-full bg-secondary-container text-xs font-bold text-on-secondary-container">{user.initials}</span><div><p class="font-bold text-primary">{user.name}</p><p class="mt-1 text-xs text-on-surface-variant">{user.email}</p></div></div></td><td class="px-4 py-4 text-on-surface-variant">{user.role}</td><td class="px-4 py-4 text-on-surface-variant">{user.lastAccess}</td><td class="px-4 py-4"><span class:list={["rounded-full px-2.5 py-1 text-[11px] font-bold", user.status === 'Activo' ? 'bg-secondary-container text-on-secondary-container' : 'bg-surface-container text-on-surface-variant']}>{user.status}</span></td><td class="px-4 py-4 text-right"><button class="text-xs font-bold text-secondary">Editar</button></td></tr>)}</tbody></table></div></section>
		<div id="user-feedback" class="hidden rounded-xl border border-secondary bg-secondary-container px-4 py-3 text-sm font-bold text-on-secondary-container">Formulario de usuario listo para conectar con la autenticación del backend.</div>
	</section>
</MainLayout>

<script>
	document.querySelector('#new-user')?.addEventListener('click', () => document.querySelector('#user-feedback')?.classList.remove('hidden'));
</script>