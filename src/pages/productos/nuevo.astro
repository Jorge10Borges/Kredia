---
import MainLayout from '../../layouts/MainLayout.astro';
const isEditing = Boolean(Astro.url.searchParams.get('id'));
const pageTitle = isEditing ? 'Editar producto' : 'Nuevo producto';
---

<MainLayout title={pageTitle}>
  <section class="mx-auto w-full max-w-4xl px-4 pb-8 pt-5 sm:px-6 md:px-8 md:pt-8"><div class="sticky top-14 z-40 -mx-4 mb-8 flex flex-col justify-between gap-5 border-b border-outline-variant bg-surface px-4 py-4 sm:-mx-6 sm:flex-row sm:items-end sm:px-6 md:-mx-8 md:px-8"><div><a href="/productos" class="inline-flex items-center gap-1 text-xs font-bold text-forest"><span class="material-symbols-outlined text-base">arrow_back</span>Productos</a><p class="mb-2 mt-4 text-xs font-bold uppercase tracking-[0.2em] text-forest">Catálogo comercial</p><h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">{pageTitle}</h2><p class="mt-2 text-sm leading-6 text-muted">Configura el nombre, los precios y la disponibilidad del producto.</p></div><div class="flex gap-3"><a href="/productos" class="rounded-xl border border-line px-4 py-2.5 text-sm font-bold text-ink">Cancelar</a><button form="product-form" type="submit" class="rounded-xl bg-forest px-4 py-2.5 text-sm font-bold text-white">{isEditing ? 'Actualizar producto' : 'Guardar producto'}</button></div></div><form id="product-form" class="space-y-6" novalidate><p class="text-xs text-muted">Los campos marcados con <span class="font-bold text-coral">*</span> son obligatorios.</p><fieldset class="rounded-2xl border border-line bg-white p-5 sm:p-6"><legend class="px-1 font-display text-lg font-bold text-ink">Datos del producto</legend><div class="mt-5 grid gap-4 sm:grid-cols-2"><label class="text-sm font-bold text-ink sm:col-span-2">Nombre <span class="text-coral">*</span><input name="nombre" required maxlength="150" placeholder="Ej. Brócoli por Kg" class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest" /></label><label class="text-sm font-bold text-ink">Precio de compra <span class="text-coral">*</span><input name="precioCompra" required type="number" min="0" step="0.01" value="0" class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest" /></label><label class="text-sm font-bold text-ink">Precio de venta <span class="text-coral">*</span><input name="precioVenta" required type="number" min="0" step="0.01" value="0" class="mt-2 w-full rounded-lg border border-line px-3 py-2.5 text-sm font-normal outline-none focus:border-forest" /></label><label class="flex items-center gap-3 self-end rounded-lg border border-line px-3 py-3 text-sm font-bold text-ink"><input name="llevaIva" type="checkbox" checked class="h-4 w-4 accent-forest" />Aplica IVA</label><label class="text-sm font-bold text-ink">Estado <span class="text-coral">*</span><select name="estado" required class="mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm font-normal outline-none focus:border-forest"><option value="activo">Activo</option><option value="inactivo">Inactivo</option></select></label></div></fieldset><div id="form-feedback" class="hidden rounded-xl border px-4 py-3 text-sm font-bold" role="status" aria-live="polite"></div></form></section>
</MainLayout>

<script>
  const apiBaseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`; const form = document.querySelector<HTMLFormElement>('#product-form')!; const feedback = document.querySelector<HTMLElement>('#form-feedback')!; const editId = new URLSearchParams(window.location.search).get('id');
  const setField = (name: string, value: unknown) => { const field = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null; if (field) field.value = String(value ?? ''); };
  if (editId) fetch(`${apiBaseUrl}api/productos.php?id=${encodeURIComponent(editId)}`).then((response) => response.ok ? response.json() : Promise.reject()).then(({ product }) => { setField('nombre', product.nombre); setField('precioCompra', product.precio_compra); setField('precioVenta', product.precio_venta); setField('estado', product.estado); const vatField = form.elements.namedItem('llevaIva') as HTMLInputElement; vatField.checked = Number(product.lleva_iva) === 1; }).catch(() => { feedback.textContent = 'No fue posible cargar el producto.'; feedback.className = 'rounded-xl border border-[#ffdad6] bg-[#fff0eb] px-4 py-3 text-sm font-bold text-coral'; });
  form.addEventListener('submit', (event) => { event.preventDefault(); if (!form.checkValidity()) return form.reportValidity(); const data = Object.fromEntries(new FormData(form)); data.llevaIva = (form.elements.namedItem('llevaIva') as HTMLInputElement).checked; fetch(`${apiBaseUrl}api/productos.php${editId ? `?id=${encodeURIComponent(editId)}` : ''}`, { method: editId ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) }).then(async (response) => ({ ok: response.ok, data: await response.json().catch(() => ({})) })).then(({ ok, data }) => { if (!ok) throw new Error(data.message ?? 'No fue posible guardar el producto.'); window.location.assign(`${apiBaseUrl}productos/`); }).catch((error: Error) => { feedback.textContent = error.message; feedback.className = 'rounded-xl border border-[#ffdad6] bg-[#fff0eb] px-4 py-3 text-sm font-bold text-coral'; }); });
</script>
