---
import MainLayout from '../../layouts/MainLayout.astro';
import ConfirmationModal from '../../components/ConfirmationModal.astro';
---

<MainLayout title="Productos">
  <section class="mx-auto w-full max-w-6xl px-4 pb-8 pt-5 sm:px-6 md:px-8 md:pt-8">
    <div class="mb-8 flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-forest">Catálogo comercial</p><h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">Productos</h2><p class="mt-2 max-w-xl text-sm leading-6 text-muted">Gestiona precios, disponibilidad y presentaciones de tus productos.</p></div><a href="/productos/nuevo" class="rounded-xl bg-forest px-4 py-2.5 text-center text-sm font-bold text-white transition hover:bg-[#164737]">Nuevo producto <span class="ml-1 text-base">+</span></a></div>
    <div class="mb-6 grid gap-4 sm:grid-cols-3"><article class="rounded-2xl border border-line bg-white p-5"><p class="text-sm text-muted">Productos registrados</p><p id="products-total" class="mt-4 font-display text-2xl font-bold text-ink">-</p><p class="mt-2 text-xs text-muted">Catálogo actual</p></article><article class="rounded-2xl border border-line bg-white p-5"><p class="text-sm text-muted">Productos activos</p><p id="products-active" class="mt-4 font-display text-2xl font-bold text-ink">-</p><p class="mt-2 text-xs text-muted">Disponibles para pedidos</p></article><article class="rounded-2xl border border-line bg-white p-5"><p class="text-sm text-muted">Margen potencial</p><p id="products-margin" class="mt-4 font-display text-2xl font-bold text-ink">-</p><p class="mt-2 text-xs text-muted">Por unidad vendida</p></article></div>
    <section class="overflow-hidden rounded-2xl border border-line bg-white"><div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-5 py-5 sm:px-6"><h3 class="font-display text-lg font-bold text-ink">Directorio de productos</h3><div class="flex gap-2"><input id="product-search" type="search" placeholder="Buscar..." aria-label="Buscar productos" class="w-36 rounded-lg border border-line px-3 py-2 text-xs outline-none focus:border-forest sm:w-48" /><button id="product-filter" class="rounded-lg border border-line px-3 py-2 text-xs font-bold text-ink">Filtrar</button></div></div><div class="overflow-x-auto"><table class="w-full min-w-180 text-left"><thead class="bg-paper text-[10px] uppercase tracking-[0.15em] text-muted"><tr><th class="px-5 py-3 font-bold sm:px-6">Producto</th><th class="px-5 py-3 font-bold">Precio compra</th><th class="px-5 py-3 font-bold">Precio venta</th><th class="px-5 py-3 font-bold">Estado</th><th class="px-5 py-3 text-right font-bold">Acciones</th></tr></thead><tbody id="products-table"></tbody></table></div><p id="products-empty" class="hidden px-6 py-10 text-center text-sm text-muted"></p></section>
  </section>
  <ConfirmationModal />
</MainLayout>

<script>
  interface Product { id: number; nombre: string; precio_compra: number; precio_venta: number; estado: string; }
  const apiBaseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`; const body = document.querySelector<HTMLTableSectionElement>('#products-table')!; const search = document.querySelector<HTMLInputElement>('#product-search')!; const empty = document.querySelector<HTMLParagraphElement>('#products-empty')!; let products: Product[] = [];
  const currency = (value: number) => new Intl.NumberFormat('es-VE', { style: 'currency', currency: 'USD' }).format(Number(value));
  const filter = () => { const query = search.value.trim().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase(); const visible = [...body.querySelectorAll<HTMLTableRowElement>('tr')].filter((row) => { const matches = (row.textContent ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().includes(query); row.hidden = !matches; return matches; }).length; empty.classList.toggle('hidden', visible > 0); };
  const render = () => { body.replaceChildren(); products.forEach((product) => { const row = document.createElement('tr'); row.className = 'border-t border-line text-sm'; row.innerHTML = `<td class="px-5 py-4 font-bold text-ink sm:px-6">${product.nombre}</td><td class="px-5 py-4 text-muted">${currency(product.precio_compra)}</td><td class="px-5 py-4 font-bold text-ink">${currency(product.precio_venta)}</td><td class="px-5 py-4"><span class="rounded-full px-2.5 py-1 text-[11px] font-bold ${product.estado === 'activo' ? 'bg-mint text-forest' : 'bg-[#edf1f0] text-muted'}">${product.estado === 'activo' ? 'Activo' : 'Inactivo'}</span></td><td class="px-5 py-4"><div class="flex justify-end gap-1"><a href="${apiBaseUrl}productos/nuevo?id=${product.id}" class="grid h-8 w-8 place-items-center rounded-lg text-forest hover:bg-mint" aria-label="Editar ${product.nombre}" title="Editar producto"><span class="material-symbols-outlined text-[19px]">edit</span></a><button type="button" data-confirm-delete data-customer-id="${product.id}" data-customer-name="${product.nombre}" data-confirm-description="Eliminarás lógicamente el producto ${product.nombre}." class="grid h-8 w-8 place-items-center rounded-lg text-coral hover:bg-[#fff0eb]" aria-label="Eliminar ${product.nombre}" title="Eliminar producto"><span class="material-symbols-outlined text-[19px]">delete</span></button></div></td>`; body.append(row); }); filter(); };
  search.addEventListener('input', filter); document.querySelector<HTMLButtonElement>('#product-filter')!.addEventListener('click', filter);
  document.addEventListener('confirmation-modal:confirm', async (event) => { const { id } = (event as CustomEvent<{ id: string }>).detail; const response = await fetch(`${apiBaseUrl}api/productos.php?id=${encodeURIComponent(id)}`, { method: 'DELETE' }); if (!response.ok) return window.alert('No se pudo eliminar el producto.'); products = products.filter((product) => String(product.id) !== id); render(); });
  fetch(`${apiBaseUrl}api/productos.php`).then((response) => response.ok ? response.json() : Promise.reject()).then((data) => { products = data.products; render(); document.querySelector<HTMLElement>('#products-total')!.textContent = String(data.kpis.total_products); document.querySelector<HTMLElement>('#products-active')!.textContent = String(data.kpis.active_products); document.querySelector<HTMLElement>('#products-margin')!.textContent = currency(data.kpis.potential_margin); }).catch(() => { empty.textContent = 'No fue posible cargar los productos.'; empty.classList.remove('hidden'); });
</script>
