---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = 'Dashboard' } = Astro.props;
const currentPath = Astro.url.pathname;
const navigation = [
	{ label: 'Dashboard', shortLabel: 'Inicio', href: '/', icon: 'dashboard' },
	{ label: 'Ventas', shortLabel: 'Ventas', href: '/ventas', icon: 'point_of_sale' },
	{ label: 'Compras', shortLabel: 'Compras', href: '/compras', icon: 'shopping_bag' },
	{ label: 'Clientes', shortLabel: 'Clientes', href: '/clientes', icon: 'groups' },
	{ label: 'Crédito', shortLabel: 'Crédito', href: '/credito', icon: 'payments' },
	{ label: 'Caja', shortLabel: 'Caja', href: '/caja', icon: 'account_balance_wallet' },
	{ label: 'Reportes', shortLabel: 'Reportes', href: '/reportes', icon: 'bar_chart' },
	{ label: 'Seguridad', shortLabel: 'Seguridad', href: '/seguridad', icon: 'admin_panel_settings' },
];
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Kredia</title>
	</head>
	<body class="min-h-screen bg-surface text-on-surface">
	<div class="min-h-screen bg-surface text-on-surface">
	<header class="sticky top-0 z-50 flex h-14 items-center justify-between border-b border-outline-variant bg-surface px-4 md:px-6">
		<a href="/" class="flex items-center gap-2 text-primary" aria-label="Ir al dashboard de Kredia"><span class="material-symbols-outlined text-[22px]">account_balance_wallet</span><span class="font-display text-display-md font-extrabold tracking-tight">Kredia</span></a>
		<div class="flex items-center gap-1"><span class="hidden text-xs font-semibold text-on-surface-variant sm:block">Sucursal principal</span><button class="grid h-11 w-11 place-items-center rounded-full text-primary transition-colors hover:bg-surface-container-low" aria-label="Buscar"><span class="material-symbols-outlined">search</span></button><button class="relative grid h-11 w-11 place-items-center rounded-full text-primary transition-colors hover:bg-surface-container-low" aria-label="Notificaciones"><span class="material-symbols-outlined">notifications</span><span class="absolute right-2 top-2 h-1.5 w-1.5 rounded-full bg-error"></span></button></div>
	</header>

	<div class="mx-auto flex w-full max-w-7xl">
		<aside class="main-sidebar hidden w-64 shrink-0 border-r border-outline-variant bg-surface-container-lowest px-4 py-6 md:sticky md:top-14 md:h-[calc(100vh-3.5rem)] md:self-start md:overflow-y-auto md:flex md:flex-col">
			<p class="mb-3 px-3 text-label-caps text-on-surface-variant">Módulos</p>
			<nav class="space-y-1" aria-label="Navegación principal">
				{navigation.map((item) => <a href={item.href} class:list={["flex items-center gap-3 rounded-lg px-3 py-3 text-body-md font-semibold transition-colors", currentPath === item.href ? "bg-secondary-container text-on-secondary-container" : "text-on-surface-variant hover:bg-surface-container-low hover:text-primary"]}><span class="material-symbols-outlined text-[21px]">{item.icon}</span>{item.label}</a>)}
			</nav>
			<div class="mt-auto border-t border-outline-variant pt-5"><div class="flex items-center gap-3 px-3"><div class="grid h-9 w-9 place-items-center rounded-full bg-tertiary-fixed text-sm font-bold text-on-tertiary-fixed">JG</div><div><p class="text-sm font-semibold text-primary">Jorge García</p><p class="text-xs text-on-surface-variant">Administrador</p></div></div></div>
		</aside>
		<main class="min-w-0 flex-1 pb-24 md:pb-8"><div class="sr-only"><h1>{title}</h1></div><slot /></main>
	</div>

	<nav class="fixed bottom-0 z-50 flex h-16 w-full items-center justify-around border-t border-outline-variant bg-surface px-2 shadow-sm md:hidden" aria-label="Navegación móvil">
		{navigation.slice(0, 5).map((item) => <a href={item.href} class:list={["flex min-w-0 flex-1 flex-col items-center justify-center gap-1 rounded-lg p-2 text-[10px] font-semibold transition-colors", currentPath === item.href ? "text-secondary" : "text-on-surface-variant"]}><span class:list={["material-symbols-outlined text-[21px]", currentPath === item.href && "fill-icon"]}>{item.icon}</span>{item.shortLabel}</a>)}
	</nav>
	</div>
	</body>
</html>